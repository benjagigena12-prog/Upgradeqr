# Contraseña del panel de administración (elige una fuerte y cámbiala en Vercel)
ADMIN_PASSWORD=cambia-esta-contraseña

# Cadena secreta larga y aleatoria, usada para firmar la sesión del panel.
# Puedes generarla en https://www.uuidgenerator.net/ o similar (usa 2-3 seguidas).
SESSION_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria

# Estas dos las rellena Vercel automáticamente cuando conectas la base
# de datos "Upstash Redis" (Storage → Marketplace Database Providers)
# a tu proyecto. No hace falta que las escribas tú a mano.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
